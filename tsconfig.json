// Not used by "docusaurus start/build" — it powers the IDE and the
// package.json "typecheck" script.
//
// baseUrl + ignoreDeprecations: @docusaurus/tsconfig itself sets `baseUrl` and
// a `@site/*` path that depends on it, so we cannot drop it here. TypeScript 6
// errors on the deprecation (TS5101); "6.0" silences it until Docusaurus ships
// a baseUrl-free base config. TypeScript stays pinned at ~6.0.3 — 7.x is a
// fleet-wide blocker (see ~/.claude/rules/package-version-known-issues.md).
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0"
  },
  "exclude": [".docusaurus", "build"]
}
